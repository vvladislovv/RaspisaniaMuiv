# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Любая случайная строка 32+ символов. Telegram будет присылать её в заголовке
# X-Telegram-Bot-Api-Secret-Token — так отсекаются поддельные запросы на вебхук.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Твой личный Telegram ID (узнать у @userinfobot). Получает алерты об ошибках
# и может включать чаты командой /enable.
ADMIN_TELEGRAM_ID=

# ─── Крон ────────────────────────────────────────────────────────────────────
# Секрет для /api/tick и /api/setup. openssl rand -hex 32
CRON_SECRET=

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — только серверный, НИКОГДА не в клиентском коде
SUPABASE_SERVICE_ROLE_KEY=

# ─── Необязательное ──────────────────────────────────────────────────────────
# Час МСК для автоотправки расписания на завтра (по умолчанию 16)
SEND_HOUR_MSK=16
# Если задан — статус-страница откроется только по ссылке ?t=<токен>
STATUS_TOKEN=
# Базовый URL деплоя. Обычно определяется автоматически из VERCEL_URL.
PUBLIC_BASE_URL=
